# Sewer Surveillance — environment configuration template
# Copy this file to .env and fill in your values.
# .env is gitignored and must NEVER be committed.

# ── Local LLM (optional) ──────────────────────────────────────────────────────
# Set to 'true' to enable automated public health bulletin generation.
# Requires LM Studio running locally at the URL below.
USE_LOCAL_LLM=false
LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_MODEL=gemma-4-26b-it

# ── Weights & Biases (optional) ───────────────────────────────────────────────
# Leave blank to disable W&B experiment tracking.
WANDB_API_KEY=

# ── Data cache ───────────────────────────────────────────────────────────────
# Directory where processed pipeline artefacts are written.
DATA_CACHE_DIR=data/processed
